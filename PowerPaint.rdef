/*
 * PowerPaint - a native Haiku port of JS Paint
 * Distributed under the terms of the MIT License.
 */

resource app_signature "application/x-vnd.idumych-PowerPaint";

// Opening a file while PowerPaint runs gives it a window in the running app.
resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "PowerPaint",
	long_info = "PowerPaint 0.1.0 - a native Haiku port of JS Paint"
};

resource file_types message {
	"types" = "image"
};

// From JS Paint (MIT): the tool box icons, the transparent selection
// option and the tool pointers.
resource(100, "tools") #'PNG ' import "images/tools.png";
resource(101, "options-transparency") #'PNG ' import "images/options-transparency.png";
resource(110, "cursor-airbrush") #'PNG ' import "images/cursor-airbrush.png";
resource(111, "cursor-eye-dropper") #'PNG ' import "images/cursor-eye-dropper.png";
resource(112, "cursor-fill-bucket") #'PNG ' import "images/cursor-fill-bucket.png";
resource(113, "cursor-magnifier") #'PNG ' import "images/cursor-magnifier.png";
resource(114, "cursor-pencil") #'PNG ' import "images/cursor-pencil.png";
resource(115, "cursor-precise") #'PNG ' import "images/cursor-precise.png";
resource(116, "cursor-precise-dotted") #'PNG ' import "images/cursor-precise-dotted.png";

