# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# release scripts (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="PowerPaint"
APP_CMD="powerpaint"
APP_SIG="application/x-vnd.idumych-PowerPaint"
RDEF="PowerPaint.rdef"

PLATFORMS="haiku"                      # Linux (Cosmoe) comes later
APP_PATH="apps/PowerPaint"
DESKBAR_NAME="PowerPaint"

# ── Version (also in the .rdef app_version) ──
VERSION="0.1.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="A native Haiku port of JS Paint, the web remake of MS Paint"
DESCRIPTION_FILE="packaging/description.txt"
HOMEPAGE="https://github.com/idumych/PowerPaint"
GITHUB_REPO="idumych/PowerPaint"
LICENSE_NAME="MIT"
COPYRIGHT="2022 Isaiah Odhner (JS Paint); 2026 the PowerPaint contributors"
PACKAGER="idumych <19998719+idumych@users.noreply.github.com>"

HPKG_REQUIRES_EXTRA=""
DESKTOP_CATEGORIES="Graphics;2DGraphics;RasterGraphics;"

# ── Build ──
HPKG_BUILD_DEPS=""
TEST_CMD="make test"
TYPECHECK_SRCS="src/ui/*.cpp"
TYPECHECK_INCLUDES="src/ui src/core"
TYPECHECK_CXXFLAGS="-D__HAIKU__ -I.haiku-headers/haiku/headers/os/be_apps/Tracker"
